# apps/web — dashboard + (on Vercel) the mounted gateway edge.
#
# For a Vercel deployment you do NOT use this file: the four variables go in the
# Vercel project's environment, and the repo-root `.env.example` documents them.
# This file is for `bun run --cwd apps/web dev` against a local Convex.
#
# Copy to apps/web/.env.local and fill in. NEVER commit a filled file
# (AGENTS.md invariant 12).

# Convex deployment this dashboard reads/writes. Written by `bunx convex dev`.
CONVEX_DEPLOYMENT=

# Convex URL used by the browser client and by preloadQuery on the server.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Public gateway origin shown on /setup and used as the OAuth issuer. On Vercel
# this is derived from the platform's own hostname and can stay unset; locally
# the gateway is mounted on this same app, so it is this app's own address.
# Plain http is only accepted for loopback.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# ──────────────────────────────────────────── server-only, no NEXT_PUBLIC_
#
# The root secret the gateway edge derives its keys from (docs/20). Locally you
# can use any value of 32+ characters; `bun run secrets -- --new` mints one.
GATEWAY_SECRET=

# Which shipped connectors this deployment serves. See the root .env.example.
CONNECTORS_ENABLED=example

# Overrides. Each is derived from GATEWAY_SECRET unless set explicitly — set one
# only when you are deliberately keeping an existing key (sealed connection
# credentials do not survive a change of CREDENTIAL_ENCRYPTION_KEY).
CREDENTIAL_ENCRYPTION_KEY=
GATEWAY_SERVICE_TOKEN=

# This app's own origin, used to build the OAuth redirect URI. Deliberately not
# derived from the Host header — a redirect URI taken from a client-controlled
# header is how an authorization code ends up delivered somewhere else. On
# Vercel it comes from the platform; locally it defaults to localhost:3000.
APP_ORIGIN=
