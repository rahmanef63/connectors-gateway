# apps/web — dashboard environment.
# Copy to apps/web/.env.local and fill in. NEVER commit a filled file
# (AGENTS.md invariant 12). No secret belongs in this app: every NEXT_PUBLIC_*
# value is shipped to the browser, and the gateway API key is pasted by the
# user into their own AI client, never stored here.

# Convex deployment this dashboard reads/writes. Written by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Convex URL used by the browser client and by preloadQuery on the server.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Public gateway origin shown on /setup. Non-sensitive by design.
# Plain http is only accepted for loopback during local development.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
