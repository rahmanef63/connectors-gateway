{
  "name": "audit-log",
  "version": "0.2.0",
  "kind": "slice",
  "description": "Paginated audit trail: who executed what, on which executor, and how policy decided it (docs/10).",
  "contract": {
    "exports": {
      "components": [
        "AuditLogPanel",
        "AuditRow",
        "DecisionBadge",
        "ExecutorBadge",
        "AuditEmptyState",
        "AuditFilters"
      ],
      "hooks": ["useAuditFilters"],
      "values": ["DEFAULT_AUDIT_LABELS", "AUDIT_COLUMNS", "DEFAULT_AUDIT_COLUMNS"],
      "types": [
        "AuditLogPanelProps",
        "AuditRowProps",
        "DecisionBadgeProps",
        "ExecutorBadgeProps",
        "AuditEmptyStateProps",
        "AuditFiltersProps",
        "UseAuditFilters",
        "LabelOverride",
        "TimestampFormatOptions",
        "AuditColumn",
        "AuditFilterState",
        "AuditLabels",
        "AuditRowView",
        "AuditStatus",
        "Tone"
      ]
    },
    "requires": {
      "ui": {
        "@/components/status-badge": ["StatusBadge", "Tone"],
        "@/components/empty-state": ["EmptyState"],
        "@/components/skeleton": ["Skeleton"],
        "@/lib/cn": ["cn"]
      },
      "uiVocabulary": {
        "tone": ["success", "warning", "danger", "neutral"],
        "classNames": ["card", "field", "btn-ghost"],
        "elements": ["table", "thead", "tbody", "tr", "th", "td", "caption", "select", "label", "button"]
      },
      "packages": ["react", "convex/react", "@cg/core"],
      "aliases": {
        "@convex/_generated/api": "Convex generated api object; the only import in config/functions.ts"
      },
      "providers": ["ConvexProvider or ConvexAuthNextjsProvider from the app shell"]
    },
    "props": {
      "AuditLogPanel": {
        "labels": "LabelOverride<AuditLabels> — optional deep override of every user-visible string",
        "columns": "readonly AuditColumn[] — optional; names outside the audit allowlist are dropped",
        "pageSize": "number — optional, default 25",
        "dateFormat": "{ locale?, timeZone? } — optional; defaults to the runtime locale"
      },
      "AuditRow": {
        "row": "AuditRowView",
        "columns": "readonly AuditColumn[] — already allowlist-filtered by the panel",
        "labels": "AuditLabels — already merged",
        "dateFormat": "TimestampFormatOptions — optional"
      },
      "AuditFilters": {
        "filters": "AuditFilterState",
        "connectors": "readonly string[] — connector ids present in the loaded page",
        "labels": "AuditLabels — already merged",
        "active": "boolean",
        "onConnectorChange": "(connectorId: string) => void",
        "onStatusChange": "(status: AuditStatus | \"\") => void",
        "onReset": "() => void"
      }
    },
    "convexFunctions": {
      "queries": ["features/audit/queries:listMine"],
      "mutations": []
    }
  }
}
