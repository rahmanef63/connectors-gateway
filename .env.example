# Connectors Gateway — example environment.
# Copy to .env and fill in. NEVER commit a filled .env (AGENTS.md invariant 12).

# ---------------------------------------------------------------- apps/gateway
GATEWAY_PORT=8787
# Public origin AI clients hit (MCP + REST).
GATEWAY_PUBLIC_URL=http://localhost:8787
# Dashboard origin the pairing flow redirects a user to.
WEB_PUBLIC_URL=http://localhost:3000

# Control plane (Convex). Gateway talks to it as a service, not as a user.
CONVEX_URL=
# Shared secret proving "this caller is the gateway process" to Convex.
# Generate: openssl rand -base64 48
GATEWAY_SERVICE_TOKEN=

# Ed25519 job-signing keypair. Gateway signs job envelopes; agents verify.
# Generate both with: bun run --cwd apps/gateway keygen
JOB_SIGNING_PRIVATE_KEY=
JOB_SIGNING_PUBLIC_KEY=
JOB_SIGNING_KEY_ID=k1

# AES-256-GCM key protecting connection credentials at rest (docs/03).
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# ------------------------------------------------------------------ apps/agent
# Relay endpoint the agent dials OUTBOUND. Never an inbound listener.
CG_GATEWAY_URL=ws://localhost:8787/device
# Where the device credential is stored (0600). Defaults to ~/.connectors-agent
CG_CONFIG_DIR=
# Blender bridge. MUST stay loopback (AGENTS.md invariant 3) — the agent
# refuses any non-loopback host.
BLENDER_BRIDGE_URL=http://127.0.0.1:9876

# -------------------------------------------------------------------- apps/web
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Public gateway origin shown on the setup page. Non-sensitive by design.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
