# Connectors Gateway — example environment.
# Copy to .env and fill in. NEVER commit a filled .env (AGENTS.md invariant 12).
#
# READ THIS FIRST if you are deploying to Vercel: you set FOUR variables there,
# and they are the four marked "SET IN VERCEL" below. Everything else here is
# either derived, defaulted, or only needed by the split deployment (a separate
# Bun gateway + local agent). docs/20-vercel-template.md is the walkthrough.

# ═══════════════════════════════════════════════════════ the four you set
#
# 1. Convex deployment URL ("cloud") — your *.convex.cloud address. SET IN
#    VERCEL. Locally, `bunx convex dev` writes it for you.
NEXT_PUBLIC_CONVEX_URL=

# 2. Convex production deploy key. SET IN VERCEL. The build uses it to push
#    functions + schema AND to provision the Convex side of the environment
#    (scripts/setup-convex-env.mjs), so it needs deployment:deploy +
#    deployment:env:view + deployment:env:write. Convex dashboard → project →
#    Production → Settings → Deploy Keys.
CONVEX_DEPLOY_KEY=

# 3. The root secret every other gateway secret is derived from. SET IN VERCEL.
#    Generate: openssl rand -base64 48
#
#    One value, four keys — see packages/auth/src/derive.ts. Run
#    `bun run secrets` to see exactly what yours expands into.
#
#    ROTATING IT RE-KEYS EVERYTHING AT ONCE, including the key that sealed your
#    stored connection credentials: rotate it and they become unopenable. A
#    deployment with live connections should pin CREDENTIAL_ENCRYPTION_KEY
#    explicitly (below) and keep that value across rotations.
GATEWAY_SECRET=

# 4. Which shipped connectors this deployment SERVES. Unset = all of them,
#    which is the demo. `none` = an explicit empty catalog. Otherwise a
#    comma-separated list of ids. An id this build does not ship is a boot
#    error, not a silent omission.
#    Shipped: example, careerpack, composio, content, mso, rahmanef, blender
CONNECTORS_ENABLED=example

# ═════════════════════════════════════════════════ derived (do not set)
#
# Each of these is computed from GATEWAY_SECRET at startup. Set one ONLY to
# override it — an existing deployment migrating onto GATEWAY_SECRET keeps its
# original CREDENTIAL_ENCRYPTION_KEY here so sealed credentials still open.
# Explicit always beats derived, per variable.
CREDENTIAL_ENCRYPTION_KEY=
GATEWAY_SERVICE_TOKEN=
JOB_SIGNING_PRIVATE_KEY=
JOB_SIGNING_PUBLIC_KEY=
JOB_SIGNING_KEY_ID=k1

# Job-signing key rotation, with an overlap window so paired agents migrate
# instead of being re-paired. Configure the OLD triple here while the fleet
# catches up, then remove all three together. All 3 or none (docs/12).
JOB_SIGNING_PREVIOUS_PRIVATE_KEY=
JOB_SIGNING_PREVIOUS_PUBLIC_KEY=
JOB_SIGNING_PREVIOUS_KEY_ID=

# ════════════════════════════════════════════════════════════════ origins
#
# On Vercel all three are derived from the platform's own variables, and a
# single-origin deploy needs none of them. Set them when you have a custom
# domain (the platform keeps reporting the *.vercel.app host), or when the
# gateway runs on its own host.
#
# This deployment's public origin. Every OAuth discovery document embeds it, so
# it is configuration and never the Host header: a client that trusted a spoofed
# issuer would carry its authorization code to someone else's token endpoint.
GATEWAY_PUBLIC_URL=
# Where the dashboard lives — the same origin on a Vercel deploy, a different
# one when the gateway is split out.
WEB_PUBLIC_URL=
# Origin the OAuth redirect URI is built from. Same reasoning as above.
APP_ORIGIN=

# ═════════════════════════════════════════════════ split deployment only
#
# Needed by apps/gateway (the Bun edge) and apps/agent (the local daemon). A
# Vercel-only deployment serves cloud connectors and needs none of this.
#
# Port the Bun gateway listens on.
GATEWAY_PORT=8787
# Convex URL the gateway calls as a SERVICE (not as a user). On Vercel this
# falls back to NEXT_PUBLIC_CONVEX_URL automatically.
CONVEX_URL=

# ------------------------------------------------------------------ apps/agent
# Relay endpoint the agent dials OUTBOUND. Never an inbound listener. Point it
# at the Bun gateway — a Vercel deployment cannot hold this socket open.
CG_GATEWAY_URL=ws://localhost:8787/device
# Where the device credential is stored (0600). Defaults to ~/.connectors-agent
CG_CONFIG_DIR=
# Blender bridge. MUST stay loopback (AGENTS.md invariant 3) — the agent
# refuses any non-loopback host.
BLENDER_BRIDGE_URL=http://127.0.0.1:9876

# ══════════════════════════════════════════ set on CONVEX, not here
#
# These belong to the Convex runtime, which never sees Vercel's environment.
# scripts/setup-convex-env.mjs provisions JWT_PRIVATE_KEY, JWKS, SITE_URL and
# GATEWAY_SERVICE_TOKEN for you during the build. The two below are decisions,
# so nothing sets them on your behalf:
#
#   bunx convex env set ADMIN_EMAILS "you@example.com"
#   bunx convex env set AUTH_GOOGLE_ID "…"
#   bunx convex env set AUTH_GOOGLE_SECRET "…"
#
# Google's callback is on the CONVEX site origin, not the dashboard:
#   https://<your-deployment>.convex.site/api/auth/callback/google
#
# SET ADMIN_EMAILS once your deployment is reachable. Without it, whoever signs
# up has no administrative ceiling above them.

# ═══════════════════════════════════════════════════════════ local dev only
#
# Public gateway origin the dashboard shows on /setup. On Vercel it is derived
# from the platform's own hostname; set it for local dev or a split deployment.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
CONVEX_DEPLOYMENT=
