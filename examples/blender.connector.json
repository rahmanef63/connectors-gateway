{
  "id": "blender",
  "name": "Blender",
  "version": "0.1.0",
  "executor": "local",
  "auth": {
    "type": "device"
  },
  "actions": [
    {
      "id": "blender.scene.inspect",
      "title": "Inspect Blender scene",
      "description": "Return a structured summary of the current Blender scene.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "includeObjects": {
            "type": "boolean",
            "description": "Include the per-object list, not just scene totals."
          },
          "maxObjects": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Upper bound on objects returned, so a huge scene cannot flood the model context."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sceneName": {
            "type": "string"
          },
          "frameCurrent": {
            "type": "integer"
          },
          "objectCount": {
            "type": "integer",
            "minimum": 0
          },
          "objects": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "sceneName",
          "objectCount"
        ]
      },
      "risk": "R0",
      "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
      },
      "requiredCapabilities": [
        "scene.inspect"
      ]
    },
    {
      "id": "blender.object.list",
      "title": "List Blender objects",
      "description": "List objects in the current scene, optionally filtered by object type.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "MESH",
              "CURVE",
              "EMPTY",
              "CAMERA",
              "LIGHT",
              "ARMATURE"
            ],
            "description": "Only return objects of this Blender type."
          },
          "maxObjects": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Upper bound on objects returned."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "objectCount": {
            "type": "integer",
            "minimum": 0
          },
          "objects": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "location": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "visible": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "objectCount",
          "objects"
        ]
      },
      "risk": "R0",
      "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
      },
      "requiredCapabilities": [
        "object.list"
      ]
    },
    {
      "id": "blender.material.list",
      "title": "List Blender materials",
      "description": "List the materials present in the open Blender file.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "maxMaterials": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Upper bound on materials returned."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "materialCount": {
            "type": "integer",
            "minimum": 0
          },
          "materials": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "users": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "name"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "materialCount",
          "materials"
        ]
      },
      "risk": "R0",
      "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
      },
      "requiredCapabilities": [
        "material.list"
      ]
    },
    {
      "id": "blender.object.create",
      "title": "Create Blender object",
      "description": "Add one primitive mesh object to the current scene.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "CUBE",
              "SPHERE",
              "PLANE",
              "CYLINDER",
              "CONE",
              "TORUS"
            ],
            "description": "Primitive to add. The bridge maps this to a fixed operator, never to caller text."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9 ._-]{1,63}$",
            "description": "Optional name for the new object."
          },
          "location": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "World-space XYZ position of the new object."
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000,
            "description": "Base size of the primitive."
          }
        },
        "additionalProperties": false,
        "required": [
          "type"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ]
      },
      "risk": "R1",
      "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": false
      },
      "requiredCapabilities": [
        "object.create"
      ]
    },
    {
      "id": "blender.object.transform",
      "title": "Transform Blender object",
      "description": "Set or offset the location, rotation and scale of one existing object.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9 ._-]{1,63}$",
            "description": "Name of the object to transform."
          },
          "location": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Target (or delta, when relative) world-space XYZ position."
          },
          "rotationEuler": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Target (or delta) XYZ Euler rotation in radians."
          },
          "scale": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Target (or multiplier, when relative) XYZ scale."
          },
          "relative": {
            "type": "boolean",
            "description": "Apply the values as deltas instead of absolute values."
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "risk": "R2",
      "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": true
      },
      "requiredCapabilities": [
        "object.transform"
      ]
    },
    {
      "id": "blender.material.apply",
      "title": "Apply material to object",
      "description": "Assign an existing material to an object, optionally creating a simple one first.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "objectName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9 ._-]{1,63}$",
            "description": "Object that receives the material."
          },
          "materialName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9 ._-]{1,63}$",
            "description": "Material to assign."
          },
          "createIfMissing": {
            "type": "boolean",
            "description": "Create a basic principled material when the name does not exist yet."
          },
          "baseColor": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "RGBA base colour used only when a material is created."
          }
        },
        "additionalProperties": false,
        "required": [
          "objectName",
          "materialName"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "objectName": {
            "type": "string"
          },
          "materialName": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "objectName",
          "materialName"
        ]
      },
      "risk": "R2",
      "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": true
      },
      "requiredCapabilities": [
        "material.apply"
      ]
    },
    {
      "id": "blender.scene.render",
      "title": "Render Blender scene",
      "description": "Render the active Blender scene using explicit render settings.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048574
          },
          "resolutionX": {
            "type": "integer",
            "minimum": 16,
            "maximum": 4096
          },
          "resolutionY": {
            "type": "integer",
            "minimum": 16,
            "maximum": 4096
          },
          "samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "format": {
            "type": "string",
            "enum": [
              "PNG",
              "JPEG",
              "OPEN_EXR"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "resolutionX",
          "resolutionY"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Base name only — never a local filesystem path."
              },
              "mimeType": {
                "type": "string"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "mimeType",
              "sizeBytes"
            ]
          },
          "renderedFrame": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "file"
        ]
      },
      "risk": "R2",
      "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": false
      },
      "requiredCapabilities": [
        "scene.render"
      ]
    },
    {
      "id": "blender.file.export",
      "title": "Export Blender scene to a file",
      "description": "Export the scene to a supported interchange format inside the export root.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 126,
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9 ._-]*(/[A-Za-z0-9][A-Za-z0-9 ._-]*)*$",
            "description": "Relative file name inside the export root. Absolute paths are rejected."
          },
          "format": {
            "type": "string",
            "enum": [
              "GLB",
              "GLTF",
              "OBJ",
              "FBX",
              "STL"
            ]
          },
          "selectedOnly": {
            "type": "boolean",
            "description": "Export only the selected objects."
          }
        },
        "additionalProperties": false,
        "required": [
          "fileName",
          "format"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Base name only — never a local filesystem path."
              },
              "mimeType": {
                "type": "string"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "mimeType",
              "sizeBytes"
            ]
          },
          "renderedFrame": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "file"
        ]
      },
      "risk": "R3",
      "annotations": {
        "readOnly": false,
        "destructive": true,
        "idempotent": false
      },
      "requiredCapabilities": [
        "file.export"
      ]
    }
  ]
}
