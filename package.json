{
  "name": "connectors-gateway",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Universal connector runtime for AI agents, cloud apps, and local software.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "dev:gateway": "bun run --cwd apps/gateway dev",
    "dev:agent": "bun run --cwd apps/agent dev",
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "bun run version:check && bun test packages adapters apps/gateway apps/agent",
    "test:convex": "bun run --cwd apps/web test",
    "verify:remote-endpoints": "bun run adapters/remote-mcp/src/verify-endpoints.ts",
    "validate": "bun run typecheck && bun run test && bun run test:convex",
    "version:check": "node scripts/check-release-version.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
