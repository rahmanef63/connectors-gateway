{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/job-envelope.schema.json",
  "title": "JobEnvelope",
  "description": "Signed unit of work delivered to a paired device (docs/05-local-agent-protocol.md). Closed shape: the envelope is signed, so an unknown property is a tampering signal, not a forward-compatible extension.",
  "type": "object",
  "required": [
    "id",
    "protocolVersion",
    "issuedAt",
    "expiresAt",
    "connector",
    "action",
    "input",
    "requestContext",
    "nonce"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "protocolVersion": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "description": "epoch ms"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "description": "epoch ms"
    },
    "connector": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "input": true,
    "requestContext": {
      "type": "object",
      "description": "Attached server-side. An AI client can never supply these fields.",
      "required": [
        "requestId",
        "userId"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
