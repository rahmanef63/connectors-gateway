{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agent-result.schema.json",
  "title": "AgentResult",
  "description": "Result frame returned by a paired agent (@cg/protocol AgentResult). An agent is a trust boundary: the gateway validates this before it is read.",
  "type": "object",
  "required": [
    "jobId",
    "status",
    "timingMs"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "error"
      ]
    },
    "output": true,
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resultFile"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "timingMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resultFile": {
      "$anchor": "resultFile",
      "title": "ResultFile",
      "type": "object",
      "description": "`ref` is a gateway-controlled handle. A local filesystem path must never appear here.",
      "required": [
        "name",
        "mimeType",
        "sizeBytes",
        "ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "error": {
      "$anchor": "error",
      "title": "GatewayErrorPayload",
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "NOT_AUTHENTICATED",
            "NOT_AUTHORIZED",
            "POLICY_DENIED",
            "APPROVAL_REQUIRED",
            "CONNECTOR_NOT_FOUND",
            "ACTION_NOT_FOUND",
            "CONNECTION_MISSING",
            "DEVICE_OFFLINE",
            "DEVICE_REVOKED",
            "CAPABILITY_UNAVAILABLE",
            "UPSTREAM_ERROR",
            "TIMEOUT",
            "CANCELLED",
            "RATE_LIMITED",
            "REPLAY_DETECTED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
